  typingSpeed: 0.02
  voiceSound: {fileID: 8300000, guid: 0b44ca8789efc58499d64244e07b2749, type: 3}
  voicePitch: 0.9
  choices:
  - dialogueIndex: 0
    choices:
    - "\xBFQu\xE9 ecosistema tiene la mayor biodiversidad?"
    - "\xBFCu\xE1l es un efecto ambiental com\xFAn de la deforestaci\xF3n?"
    - "\xBFPor qu\xE9 son importantes las especies nativas en un ecosistema?"
    - "\xBFCu\xE1l es una funci\xF3n importante de los humedales?"
