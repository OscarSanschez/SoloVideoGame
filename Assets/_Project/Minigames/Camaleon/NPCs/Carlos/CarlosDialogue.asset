  voicePitch: 1
  choices:
  - dialogueIndex: 0
    choices:
    - "\xBFCu\xE1l es uno de los roles m\xE1s importantes de los polinizadores?"
    - "\xBFCu\xE1l es un efecto ambiental com\xFAn de la deforestaci\xF3n?"
    - "\xBFQu\xE9 proporcionan los arrecifes de coral a la vida marina?"
    - "\xBFCu\xE1l es una funci\xF3n importante de los humedales?"
