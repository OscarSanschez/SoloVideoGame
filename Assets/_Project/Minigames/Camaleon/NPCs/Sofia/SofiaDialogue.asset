  typingSpeed: 0.02
  voiceSound: {fileID: 8300000, guid: 0b44ca8789efc58499d64244e07b2749, type: 3}
  voicePitch: 0.9
  choices:
  - dialogueIndex: 0
    choices:
    - "\xBFPor qu\xE9 es importante la biodiversidad en un ecosistema?"
    - "\xBFPor qu\xE9 son importantes los manglares?"
    - "\xBFPor qu\xE9 son importantes las especies nativas en un ecosistema?"
    - "\xBFCu\xE1l es una forma efectiva de ayudar a conservar los h\xE1bitats?"
    nextDialogueIndexes: 01000000020000000300000004000000
